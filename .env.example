# Copy to .env.local and fill in your values

# Postgres (Neon / Supabase / any Postgres). Use the pooled URL for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/db?sslmode=require"
# Direct (non-pooled) URL for migrations — optional but recommended with Neon
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST/db?sslmode=require"

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
# Server only — never use NEXT_PUBLIC_ for this
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY

# Temporary local browsing without sign-in (ignored in production builds)
NEXT_PUBLIC_DEMO_MODE=true

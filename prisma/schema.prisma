generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

model Company {
  id              String   @id @default(cuid())
  name            String
  currency        String   @default("TTD")
  vatRate         Float    @default(0.125)
  /// When false, VAT is not applied to sales
  taxEnabled      Boolean  @default(true)
  /// RETAIL | SERVICE | BOTH
  businessType    String   @default("BOTH")
  /// red-white-black | yellow-parrot | light | dark
  theme           String   @default("red-white-black")
  /// card | list — default inventory browsing layout
  inventoryViewMode String @default("card")
  /// en | es | fr
  language        String   @default("en")
  /// RETAIL | RETAIL_SERVICE — home screen item layout
  homeLayout      String   @default("RETAIL")
  /// Allow printing receipts from POS
  receiptPrinting Boolean  @default(true)
  printerName     String?
  /// Optional logo as data URL (small PNG/JPEG/WebP)
  receiptLogoData String?
  /// Business logo for invoices, quotations, and reports
  businessLogoData String?
  /// Letterhead image for branded documents and reports
  letterheadData String?
  /// Receipt header text; blank falls back to business name
  receiptHeader   String?
  /// Receipt footer text; blank falls back to thank-you default
  receiptFooter   String?
  /// Show customer name on printed/viewed receipts
  receiptShowCustomer Boolean @default(true)
  /// Show sale notes/comments on receipts
  receiptShowComments Boolean @default(false)
  /// Honey trade: show persons involved in the sale on receipts
  receiptHoneyPersons Boolean @default(false)
  /// Honey trade: print Apiary Number on receipts
  receiptShowApiaryNumber Boolean @default(false)
  receiptApiaryNumber String?
  /// Honey trade: print OPR # on receipts
  receiptShowOprNumber Boolean @default(false)
  receiptOprNumber String?
  /// Receipt language: en | es | fr
  receiptLanguage String @default("en")
  /// Feature: save/edit POS tickets before payment
  featureOpenTickets Boolean @default(false)
  /// Feature: weekly low-stock email digest
  featureLowStockEmail Boolean @default(false)
  /// Feature: warn (and email) when selling out-of-stock items
  featureOutOfStockWarn Boolean @default(false)
  /// FREE_RETAIL | STANDARD
  planTier        String   @default("STANDARD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members             CompanyMember[]
  stores              Store[]
  posRegisters        PosRegister[]
  paymentTypes        PaymentType[]
  inventoryCategories InventoryCategory[]
  variableNames       VariableNameCatalog[]
  discountPresets     DiscountPreset[]
  customers           Customer[]
  suppliers           Supplier[]
  supplierItems       SupplierItem[]
  products            Product[]
  employees           Employee[]
  quotations          Quotation[]
  jobs                Job[]
  invoices            Invoice[]
  payments            Payment[]
  expenses            Expense[]
  sales               Sale[]
}

/// Physical or logical location under a company (POS settings are per store).
model Store {
  id                String   @id @default(cuid())
  companyId         String
  name              String
  /// card | list
  inventoryViewMode String   @default("card")
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  posRegisters        PosRegister[]
  inventoryCategories InventoryCategory[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// Company-defined POS / expense payment methods
model PaymentType {
  id        String   @id @default(cuid())
  companyId String
  code      String
  label     String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

/// Per-store inventory / product categories (colours, POS filters).
/// Every store starts with the same default list; edits apply only to that store.
model InventoryCategory {
  id        String   @id @default(cuid())
  companyId String
  storeId   String?
  name      String
  /// Hex colour for category badges (e.g. #C41E3A)
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([companyId])
  @@index([storeId])
}

/// Named POS station / till within a store (free retail allows up to 2 per store).
model PosRegister {
  id        String   @id @default(cuid())
  companyId String
  storeId   String?
  name      String
  /// 0 = POS 1 (full access), 1 = POS 2 (limited)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store   Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@index([companyId])
  @@index([storeId])
}

/// Links a Supabase Auth user id to exactly one company (owner for now).
model CompanyMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  invoices   Invoice[]
  payments   Payment[]
  jobs       Job[]
  expenses   Expense[]
  sales      Sale[]

  @@index([companyId])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  /// Phone or primary contact line
  phone     String?
  address   String?
  /// Supplier sales representative
  salesRep  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  expenses Expense[]
  items    SupplierItem[]

  @@index([companyId])
}

/// Supply / procurement line catalog for a supplier (cost + unit of measure).
model SupplierItem {
  id         String   @id @default(cuid())
  companyId  String
  supplierId String
  name       String
  /// each | kg | lb | case | dozen | m | L | pack · …
  unit       String   @default("each")
  /// Procurement cost in cents
  unitCost   Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([supplierId])
}

model Product {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  description String?
  /// Retail / service category for POS + reports
  category    String  @default("General")
  unit        String  @default("each")
  unitCost    Int     @default(0)
  /// Fixed price in cents; ignored at POS when variablePrice is true
  unitPrice   Int     @default(0)
  /// When true, cashier enters price at POS
  variablePrice Boolean @default(false)
  stockQty    Float   @default(0)
  minStock    Float   @default(0)
  trackStock  Boolean @default(true)
  isService   Boolean @default(false)
  supplierId  String?
  /// Optional product photo as data URL (PNG/JPEG/WebP)
  imageData   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  variables    ProductVariable[]
  stockMoves   StockMovement[]
  quoteLines   QuotationLine[]
  invoiceLines InvoiceLine[]
  jobMaterials JobMaterial[]
  saleLines    SaleLine[]

  @@index([companyId])
}

/// Attribute on a product (e.g. Colour → Red, Blue, Black)
model ProductVariable {
  id        String   @id @default(cuid())
  productId String
  name      String
  /// JSON string array of option labels
  options   String   @default("[]")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// Reusable variable names for the company dropdown (Colour, Size, …)
model VariableNameCatalog {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

/// Preset percentage discounts (editable at POS 1)
model DiscountPreset {
  id        String   @id @default(cuid())
  companyId String
  name      String
  percent   Float
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model Employee {
  id         String   @id @default(cuid())
  companyId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  role       String?
  hourlyRate Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([companyId])
}

model Quotation {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  customerId    String
  status        String    @default("DRAFT")
  title         String?
  notes         String?
  labourCost    Int       @default(0)
  materialsCost Int       @default(0)
  equipmentCost Int       @default(0)
  transportCost Int       @default(0)
  otherCost     Int       @default(0)
  markupPct     Float     @default(25)
  /// When true, quote uses a fixed selling price (no markup %)
  fixedPrice    Boolean   @default(false)
  subtotal      Int       @default(0)
  total         Int       @default(0)
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])
  lines    QuotationLine[]
  job      Job?
  invoice  Invoice?

  @@unique([companyId, number])
  @@index([companyId])
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  description String
  category    String  @default("MATERIALS")
  quantity    Float   @default(1)
  unitCost    Int     @default(0)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
}

model Job {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  customerId    String
  quotationId   String?   @unique
  title         String
  status        String    @default("ACTIVE")
  contractValue Int       @default(0)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id])
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  materials   JobMaterial[]
  timeEntries TimeEntry[]
  expenses    Expense[]
  invoices    Invoice[]

  @@unique([companyId, number])
  @@index([companyId])
}

model JobMaterial {
  id        String  @id @default(cuid())
  jobId     String
  productId String?
  name      String
  quantity  Float   @default(1)
  unitCost  Int     @default(0)
  totalCost Int     @default(0)

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model TimeEntry {
  id            String   @id @default(cuid())
  employeeId    String
  jobId         String?
  date          DateTime
  hours         Float
  overtimeHours Float    @default(0)
  hourlyRate    Int
  notes         String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  job      Job?     @relation(fields: [jobId], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  companyId   String
  number      String
  customerId  String
  jobId       String?
  quotationId String?   @unique
  status      String    @default("DRAFT")
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  subtotal    Int       @default(0)
  taxAmount   Int       @default(0)
  total       Int       @default(0)
  amountPaid  Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id])
  job       Job?          @relation(fields: [jobId], references: [id])
  quotation Quotation?    @relation(fields: [quotationId], references: [id])
  lines     InvoiceLine[]
  payments  Payment[]

  @@unique([companyId, number])
  @@index([companyId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  invoiceId  String?
  amount     Int
  method     String   @default("BANK")
  reference  String?
  paidAt     DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([companyId])
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  category      String
  description   String?
  amount        Int
  date          DateTime @default(now())
  paymentMethod String   @default("CASH")
  jobId         String?
  supplierId    String?
  customerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  type      String
  quantity  Float
  unitCost  Int      @default(0)
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Sale {
  id            String   @id @default(cuid())
  companyId     String
  number        String
  customerId    String?
  posRegisterId String?
  status        String   @default("COMPLETED") // OPEN | COMPLETED | VOID
  subtotal      Int      @default(0)
  taxAmount     Int      @default(0)
  total         Int      @default(0)
  amountPaid    Int      @default(0)
  method        String   @default("CASH")
  notes         String?
  /// Names of persons involved (honey sales), when enabled in settings
  honeyPersons  String?
  discountPercent Float  @default(0)
  discountAmount  Int    @default(0)
  /// True when this sale is a refund of another sale
  isRefund      Boolean  @default(false)
  refundOfSaleId String?
  soldAt        DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id])
  posRegister PosRegister? @relation(fields: [posRegisterId], references: [id])
  refundOf    Sale?        @relation("SaleRefunds", fields: [refundOfSaleId], references: [id])
  refunds     Sale[]       @relation("SaleRefunds")
  lines       SaleLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status])
  @@index([posRegisterId])
  @@index([refundOfSaleId])
}

model SaleLine {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

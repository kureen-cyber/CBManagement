generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

model Company {
  id              String   @id @default(cuid())
  name            String
  currency        String   @default("TTD")
  vatRate         Float    @default(0.125)
  /// When false, VAT is not applied to sales
  taxEnabled      Boolean  @default(true)
  /// RETAIL | SERVICE | BOTH
  businessType    String   @default("BOTH")
  /// light | dark
  theme           String   @default("light")
  /// en | es | fr
  language        String   @default("en")
  /// RETAIL | RETAIL_SERVICE — home screen item layout
  homeLayout      String   @default("RETAIL")
  /// Allow printing receipts from POS
  receiptPrinting Boolean  @default(true)
  printerName     String?
  /// FREE_RETAIL | STANDARD
  planTier        String   @default("STANDARD")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  members      CompanyMember[]
  posRegisters PosRegister[]
  customers    Customer[]
  suppliers    Supplier[]
  products     Product[]
  employees    Employee[]
  quotations   Quotation[]
  jobs         Job[]
  invoices     Invoice[]
  payments     Payment[]
  expenses     Expense[]
  sales        Sale[]
}

/// Named POS station / till (free retail allows up to 2).
model PosRegister {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@index([companyId])
}

/// Links a Supabase Auth user id to exactly one company (owner for now).
model CompanyMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  companyId String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotations Quotation[]
  invoices   Invoice[]
  payments   Payment[]
  jobs       Job[]
  expenses   Expense[]
  sales      Sale[]

  @@index([companyId])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  phone     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]
  expenses Expense[]

  @@index([companyId])
}

model Product {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  sku         String?
  description String?
  /// Retail / service category for POS + reports
  category    String  @default("General")
  unit        String  @default("each")
  unitCost    Int     @default(0)
  unitPrice   Int     @default(0)
  stockQty    Float   @default(0)
  minStock    Float   @default(0)
  trackStock  Boolean @default(true)
  isService   Boolean @default(false)
  supplierId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier     Supplier?       @relation(fields: [supplierId], references: [id])
  stockMoves   StockMovement[]
  quoteLines   QuotationLine[]
  invoiceLines InvoiceLine[]
  jobMaterials JobMaterial[]
  saleLines    SaleLine[]

  @@index([companyId])
}

model Employee {
  id         String   @id @default(cuid())
  companyId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  role       String?
  hourlyRate Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  timeEntries TimeEntry[]

  @@index([companyId])
}

model Quotation {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  customerId    String
  status        String    @default("DRAFT")
  title         String?
  notes         String?
  labourCost    Int       @default(0)
  materialsCost Int       @default(0)
  equipmentCost Int       @default(0)
  transportCost Int       @default(0)
  otherCost     Int       @default(0)
  markupPct     Float     @default(25)
  subtotal      Int       @default(0)
  total         Int       @default(0)
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])
  lines    QuotationLine[]
  job      Job?
  invoice  Invoice?

  @@unique([companyId, number])
  @@index([companyId])
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  description String
  category    String  @default("MATERIALS")
  quantity    Float   @default(1)
  unitCost    Int     @default(0)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id])
}

model Job {
  id            String    @id @default(cuid())
  companyId     String
  number        String
  customerId    String
  quotationId   String?   @unique
  title         String
  status        String    @default("ACTIVE")
  contractValue Int       @default(0)
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer      @relation(fields: [customerId], references: [id])
  quotation   Quotation?    @relation(fields: [quotationId], references: [id])
  materials   JobMaterial[]
  timeEntries TimeEntry[]
  expenses    Expense[]
  invoices    Invoice[]

  @@unique([companyId, number])
  @@index([companyId])
}

model JobMaterial {
  id        String  @id @default(cuid())
  jobId     String
  productId String?
  name      String
  quantity  Float   @default(1)
  unitCost  Int     @default(0)
  totalCost Int     @default(0)

  job     Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model TimeEntry {
  id            String   @id @default(cuid())
  employeeId    String
  jobId         String?
  date          DateTime
  hours         Float
  overtimeHours Float    @default(0)
  hourlyRate    Int
  notes         String?
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  job      Job?     @relation(fields: [jobId], references: [id])
}

model Invoice {
  id          String    @id @default(cuid())
  companyId   String
  number      String
  customerId  String
  jobId       String?
  quotationId String?   @unique
  status      String    @default("DRAFT")
  issueDate   DateTime  @default(now())
  dueDate     DateTime?
  subtotal    Int       @default(0)
  taxAmount   Int       @default(0)
  total       Int       @default(0)
  amountPaid  Int       @default(0)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer  Customer      @relation(fields: [customerId], references: [id])
  job       Job?          @relation(fields: [jobId], references: [id])
  quotation Quotation?    @relation(fields: [quotationId], references: [id])
  lines     InvoiceLine[]
  payments  Payment[]

  @@unique([companyId, number])
  @@index([companyId])
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}

model Payment {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  invoiceId  String?
  amount     Int
  method     String   @default("BANK")
  reference  String?
  paidAt     DateTime @default(now())
  notes      String?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([companyId])
}

model Expense {
  id            String   @id @default(cuid())
  companyId     String
  category      String
  description   String?
  amount        Int
  date          DateTime @default(now())
  paymentMethod String   @default("CASH")
  jobId         String?
  supplierId    String?
  customerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([companyId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  type      String
  quantity  Float
  unitCost  Int      @default(0)
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Sale {
  id            String   @id @default(cuid())
  companyId     String
  number        String
  customerId    String?
  posRegisterId String?
  status        String   @default("COMPLETED")
  subtotal      Int      @default(0)
  taxAmount     Int      @default(0)
  total         Int      @default(0)
  amountPaid    Int      @default(0)
  method        String   @default("CASH")
  notes         String?
  soldAt        DateTime @default(now())
  createdAt     DateTime @default(now())

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id])
  posRegister PosRegister? @relation(fields: [posRegisterId], references: [id])
  lines       SaleLine[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([posRegisterId])
}

model SaleLine {
  id          String  @id @default(cuid())
  saleId      String
  productId   String?
  description String
  quantity    Float   @default(1)
  unitPrice   Int     @default(0)
  lineTotal   Int     @default(0)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
}
